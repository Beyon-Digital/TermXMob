+// TEST-ONLY: this copied harness inspects its own WKWebView and exits boundedly.
+#[cfg(target_os = "macos")]
+fn fixture_native_probe(app: &tauri::AppHandle) {
+    let Ok(destination) = std::env::var("TERMX_FIXTURE_PROBE_DIR") else { return; };
+    let handle = app.clone();
+    std::thread::spawn(move || {
+        std::thread::sleep(std::time::Duration::from_secs(3));
+        if let Some(window) = handle.get_webview_window("main") {
+            let output = destination.clone();
+            let _ = window.with_webview(move |webview| {
+                extern "C" { fn termx_fixture_probe(view: *mut std::ffi::c_void, destination: *const std::ffi::c_char); }
+                let path = std::ffi::CString::new(output).unwrap();
+                unsafe { termx_fixture_probe(webview.inner(), path.as_ptr()); }
+            });
+        }
+        let updater_probe = std::env::var("TERMX_FIXTURE_PROBE_UPDATER").as_deref() == Ok("1");
+        if updater_probe {
+            let directory = std::path::Path::new(&destination).join("updater");
+            let _ = std::fs::create_dir_all(&directory);
+            let owner = handle.clone();
+            let _ = handle.run_on_main_thread(move || {
+                // Same bundled updater URL/capability; deliberately omit updater::show's network check.
+                let _ = tauri::WebviewWindowBuilder::new(&owner, "updater", tauri::WebviewUrl::App("updater.html".into()))
+                    .title("Termx fixture updater")
+                    .inner_size(560.0, 640.0)
+                    .initialization_script("window.__TERMX_FIXTURE_ERRORS=[];addEventListener('error',event=>window.__TERMX_FIXTURE_ERRORS.push(String(event.message)));addEventListener('unhandledrejection',event=>window.__TERMX_FIXTURE_ERRORS.push(String(event.reason)));")
+                    .on_navigation(|url| (url.scheme() == "tauri" || url.host_str() == Some("tauri.localhost")) && url.path() == "/updater.html")
+                    .build();
+            });
+            std::thread::sleep(std::time::Duration::from_secs(2));
+            if let Some(window) = handle.get_webview_window("updater") {
+                let output = directory.to_string_lossy().into_owned();
+                let _ = window.with_webview(move |webview| {
+                    extern "C" { fn termx_fixture_probe(view: *mut std::ffi::c_void, destination: *const std::ffi::c_char); }
+                    let path = std::ffi::CString::new(output).unwrap();
+                    unsafe { termx_fixture_probe(webview.inner(), path.as_ptr()); }
+                });
+            }
+        }
+        for _ in 0..300 {
+            let main_done = std::path::Path::new(&destination).join("done.txt").exists();
+            let updater_done = !updater_probe || std::path::Path::new(&destination).join("updater/done.txt").exists();
+            if main_done && updater_done { break; }
+            std::thread::sleep(std::time::Duration::from_millis(100));
+        }
+        crate::quit(&handle);
+    });
+}
 
 pub static QUITTING: AtomicBool = AtomicBool::new(false);
 
