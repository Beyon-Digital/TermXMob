+// TEST-ONLY INSTRUMENTATION: own WKWebView snapshot. No screen/TCC capture.
+#import <AppKit/AppKit.h>
+void termx_fixture_probe(void *pointer, const char *destination) {
+    if (![NSThread isMainThread] || !pointer || !destination) return;
+    WKWebView *view = (__bridge WKWebView *)pointer;
+    NSString *directory = [NSString stringWithUTF8String:destination];
+    void (^finish)(NSString *) = ^(NSString *reason) {
+        [reason writeToFile:[directory stringByAppendingPathComponent:@"done.txt"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    };
+    [view callAsyncJavaScript:@"for (let n=0;n<100&&!document.querySelector('.sign-in,.workspace-root');n++) await new Promise(r=>setTimeout(r,100));\nconst timeout=p=>Promise.race([p,new Promise((_,reject)=>setTimeout(()=>reject(new Error('probe request timed out')),5000))]);\nconst invoke=window.__TAURI_INTERNALS__?.invoke;\nlet methods=null,methodsError=null,mediaGate=null;\ntry{methods=await timeout(invoke('workspace_request',{path:'/auth/methods',method:'GET',data:null}));}catch(error){methodsError=String(error);}\ntry{await timeout(invoke('workspace_binary',{path:'/api/media/artifacts/native-studio-fixture/export?format=original',method:'GET',bodyBase64:null,contentType:'application/octet-stream'}));mediaGate={rejected:false};}catch(error){mediaGate={rejected:true,error:String(error)};}\nreturn JSON.stringify({proof:'instrumented-own-wkwebview-no-auth',href:location.href,title:document.title,ready:document.readyState,userAgent:navigator.userAgent,tauri:!!window.__TAURI_INTERNALS__,signIn:!!document.querySelector('.sign-in'),workspace:!!document.querySelector('.workspace-root'),headings:[...document.querySelectorAll('h1,h2,h3')].map(x=>x.textContent),body:document.body.innerText.slice(0,12000),inputs:[...document.querySelectorAll('input')].map(x=>({type:x.type,label:x.getAttribute('aria-label')})),buttons:[...document.querySelectorAll('button')].map(x=>x.textContent.trim()),alerts:[...document.querySelectorAll('[role=alert]')].map(x=>x.textContent),pageErrors:window.__TERMX_FIXTURE_ERRORS||[],methods,methodsError,mediaGate,resources:performance.getEntriesByType('resource').map(x=>({name:x.name,transferSize:x.transferSize}))});" arguments:@{} inFrame:nil inContentWorld:WKContentWorld.pageWorld completionHandler:^(id result, NSError *error) {
+        if (error) {
+            [error.localizedDescription writeToFile:[directory stringByAppendingPathComponent:@"probe-error.txt"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+            finish(@"JavaScript probe failed"); return;
+        }
+        [(NSString *)result writeToFile:[directory stringByAppendingPathComponent:@"dom.json"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        [view takeSnapshotWithConfiguration:nil completionHandler:^(NSImage *image, NSError *snapshotError) {
+            if (snapshotError || !image) {
+                [(snapshotError.localizedDescription ?: @"No native image") writeToFile:[directory stringByAppendingPathComponent:@"snapshot-error.txt"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+                finish(@"WK snapshot failed"); return;
+            }
+            NSBitmapImageRep *bitmap = [NSBitmapImageRep imageRepWithData:image.TIFFRepresentation];
+            NSData *png = [bitmap representationUsingType:NSBitmapImageFileTypePNG properties:@{}];
+            [png writeToFile:[directory stringByAppendingPathComponent:@"native-signin.png"] atomically:YES];
+            finish(@"Native DOM and snapshot completed");
+        }];
+    }];
+}
