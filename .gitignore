# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Node
node_modules/
# The exported web bundle keeps its fonts under assets/node_modules/*/build/;
# ignoring any of those paths ships packaged builds with no icon font.
!desktop/web/assets/**
package-lock.json
.DS_Store

# Swift helper build trees
helpers/macos/TermxCapture/.build/
helpers/macos/TermxVirtualDisplay/.build/

# Local codesign identity, p12, and persisted keychain
helpers/macos/signing/signing.env
helpers/macos/signing/*.p12
helpers/macos/signing/*.keychain-db
helpers/macos/signing/*.keychain-db-db
helpers/macos/signing/*.keychain-db-old

# Desktop packaging artifacts
desktop/build/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/resources/backend/
desktop/src-tauri/resources/backend.pid

# Local desktop signing credentials
desktop/signing.env
