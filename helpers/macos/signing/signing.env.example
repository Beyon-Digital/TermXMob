# Copy to signing.env in this directory (gitignored). Used only by helpers/macos/sign.sh
# on your Mac with Command Line Tools — no Xcode.app required.
#
# Ad-hoc (default):
#   CODESIGN_IDENTITY=-
#
# Developer ID / Apple Development identity already in login keychain:
#   CODESIGN_IDENTITY=Developer ID Application: Your Name (TEAMID)
#
# Or import a .p12 once; the dedicated keychain is persisted next to this file:
#   P12_PATH=/absolute/path/to/developerID.p12
#   P12_PASSWORD=...
#   KEYCHAIN_PASSWORD=pick-a-local-password

CODESIGN_IDENTITY=-
P12_PATH=
P12_PASSWORD=
KEYCHAIN_PASSWORD=termx-signing
KEYCHAIN_PATH=
