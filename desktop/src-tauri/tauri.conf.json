{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termx",
  "version": "0.2.6",
  "identifier": "com.jaexxxy.termx",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend/": "backend/"
    },
    "copyright": "Copyright \u00a9 Termx",
    "category": "DeveloperTool",
    "shortDescription": "An AI chat and coding workspace for your machines.",
    "longDescription": "TermX provides a dedicated desktop and browser workspace with AI sessions, projects, code, terminals, browser automation, and managed access.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": [
          "en-US"
        ]
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libnss3",
          "libnspr4",
          "libatk1.0-0",
          "libatk-bridge2.0-0",
          "libcups2",
          "libdrm2",
          "libxkbcommon0",
          "libxcomposite1",
          "libxdamage1",
          "libxfixes3",
          "libxrandr2",
          "libgbm1",
          "libasound2 | libasound2t64",
          "wmctrl",
          "xdotool",
          "imagemagick"
        ]
      },
      "rpm": {
        "epoch": 0,
        "release": "1",
        "depends": [
          "nss",
          "nspr",
          "atk",
          "at-spi2-atk",
          "cups-libs",
          "libdrm",
          "libxkbcommon",
          "libXcomposite",
          "libXdamage",
          "libXfixes",
          "libXrandr",
          "mesa-libgbm",
          "alsa-lib",
          "wmctrl",
          "xdotool",
          "ImageMagick"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Beyon-Digital/TermXMob/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzQTdDNjAwNTY2NTJGQTUKUldTbEwyVldBTWFuSTFjcS9TYVR2cUZsSlIweG83ODNQeFNzRDh5Tk83b08yU1k2Q0RiY0ovWEwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
