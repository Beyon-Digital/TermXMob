{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termx",
  "version": "0.1.3",
  "identifier": "com.jaexxxy.termx",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend/": "backend/"
    },
    "copyright": "Copyright \u00a9 Termx",
    "category": "DeveloperTool",
    "shortDescription": "Run a terminal on your laptop. Use it from your phone or browser.",
    "longDescription": "Termx hosts interactive terminal sessions on your machine and lets you connect from your phone or browser, including optional screen view and control.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": [
          "en-US"
        ]
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "epoch": 0,
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
