{
  "request": {
    "method": "POST",
    "path": "/query-specs/compile",
    "as": "alice",
    "body": {
      "spec": {
        "version": 1,
        "source": "conn_01",
        "from": {
          "table": "sales",
          "alias": "s"
        },
        "joins": [],
        "select": [],
        "filters": {
          "op": "and",
          "items": []
        },
        "group_by": [],
        "aggregates": [],
        "sort": [],
