# Termx signing configuration (copy to desktop/signing.env — gitignored).
#
# The release scripts read this file automatically:
#   desktop/scripts/sign_macos_release.sh
#   desktop/scripts/sign_windows_release.ps1
#   desktop/scripts/sign_linux_release.sh
# Explicit command-line flags and real environment variables win over this file.

# --- macOS -------------------------------------------------------------------
# Developer ID Application certificate. Auto-detected from your keychain when unset;
# leave it empty for an ad-hoc signature that still runs on this Mac.
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
#
# Optional keychain that holds the identity:
# APPLE_KEYCHAIN=
#
# Notarization, pick one:
# 1) App Store Connect API key (recommended: scoped and revocable)
# APPLE_API_KEY_PATH=~/Downloads/AuthKey_ABC123XYZ.p8
# APPLE_API_KEY_ID=ABC123XYZ
# APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
# 2) keychain profile created by desktop/scripts/setup_macos_notary.sh
# NOTARY_PROFILE=termx-notary

# --- Windows -----------------------------------------------------------------
# Either a .pfx path:
# TERMX_WINDOWS_PFX=C:\certs\termx.pfx
# TERMX_WINDOWS_PFX_PASSWORD=secret
#
# Or the base64 form used by CI:
# WINDOWS_CERTIFICATE=base64-pfx
# WINDOWS_CERTIFICATE_PASSWORD=secret

# --- Linux -------------------------------------------------------------------
# GPG key id/email used for detached signatures.
# TERMX_GPG_KEY=you@example.com

# --- Shared ------------------------------------------------------------------
# Override artifact discovery (defaults also search ./dist, ., ~/Downloads and the
# Tauri bundle output).
# TERMX_SIGN_INPUT=/path/to/artifacts
